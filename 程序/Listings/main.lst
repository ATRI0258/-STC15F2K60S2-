 144          void Read_Key ()
 145          {
 146   1              static uint8_t key2_x;
 147   1              uint8_t dat;
 148   1              
 149   1          dat=(P2&0x7f)^0x7f; 
 150   1              
 151   1              switch(key2_x)
 152   1              { 
 153   2                      case 0X00 : if(dat != 0X00) key2_x = 1;  break;
 154   2                      
 155   2                      case 0X01 : if(dat == 0X00) key2_x = 0;
 156   2                                                                      else
 157   2                      {
 158   3                        key2_x = 2;
 159   3                        switch(dat) 
 160   3                        {
 161   4                          case 0x01 : Moshi=~Moshi; break;
 162   4                          case 0x02 : if(Moshi == 0){ Deng_bit=~Deng_bit; } break;                      
 163   4                          case 0x10 : Shezhi=~Shezhi;Ds1s=0; break;
 164   4                          case 0x20 : if(Shezhi == 1 && ( Shezhi_liumingzhi+50 < 600 ))   Shezhi_liumingzhi+=50;
             - break;
 165   4                          case 0x40 : if(Shezhi == 1 && ( Shezhi_liumingzhi - 50 > 0 ))   Shezhi_liumingzhi-=50;
             - break;                       
 166   4                          default : break;
 167   4                        }
 168   3                      } break;                
 169   2                      case 0X02 :  if(dat == 0X00){ key2_x = 0; } break;
 170   2              }
 171   1      }
